// Oumno Éducation — schéma de données
// Voir /root/.claude/plans/cr-e-une-plateforme-cr-ant-dazzling-mitten.md pour le contexte produit.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Comptes
// ---------------------------------------------------------------------------

model Parent {
  id           String   @id @default(cuid())
  // Un des deux (email, username) doit être renseigné — l'inscription n'exige plus d'email,
  // voir registerParent. authorize() dans src/auth.ts accepte l'un ou l'autre pour se connecter.
  email        String?  @unique
  username     String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  children            Child[]
  tutoringRequests    TutoringRequest[]
  suggestionThreads   SuggestionThread[]
  chatThreads         ChatThreadParticipant[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
}

model Child {
  id         String   @id @default(cuid())
  // Un enfant appartient à exactement un parent OU un prof (jamais les deux, jamais aucun) —
  // contrainte applicative, pas de CHECK SQL simple avec deux colonnes nullable. Un prof peut
  // créer un profil enfant de façon autonome (teacherId), sans passer par un parent.
  parentId   String?
  parent     Parent?  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  teacherId  String?
  teacher    Teacher? @relation("TeacherStudents", fields: [teacherId], references: [id], onDelete: Cascade)
  name       String
  pinHash    String
  avatarKey  String?
  birthYear  Int
  // Classe scolaire déclarée par le parent (ex. "CP", "6e") — nullable pour les comptes créés
  // avant l'ajout de ce champ. Signal d'appoint pour les recommandations (voir
  // src/lib/progression/recommendation.ts), pas un programme d'exercices séparé par classe.
  gradeLevel String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  skillProgress              ChildSkillProgress[]
  exerciseAttempts           ExerciseAttempt[]
  evaluations                Evaluation[]
  integrityEvents            IntegrityEvent[]
  badges                     ChildBadge[]
  streak                     Streak?
  writingProfile             ChildWritingProfile?
  pointsWallet               PointsWallet?
  rewardRedemptions          RewardRedemption[]
  assessments                ChildAssessment[]
  progressReports            ProgressReport[]
  lessonStoryEntries         LessonStoryEntry[]
  tutoringRequests           TutoringRequest[]
  suggestionThreads          SuggestionThread[]
  chatThreads                ChatThreadParticipant[]
  dailyRecommendations       DailyRecommendation[]
  teacherExerciseSubmissions TeacherExerciseSubmission[]
  curatedExerciseAttempts    CuratedExerciseAttempt[]
  levelCompletionBonuses     LevelCompletionBonus[]
  dailyMysteryBoxes          DailyMysteryBox[]

  @@index([parentId])
  @@index([teacherId])
}

model Teacher {
  id                 String   @id @default(cuid())
  email              String   @unique
  // Généré à la création (candidature approuvée) — permet une connexion par identifiant en plus
  // de l'email, cohérent avec le compte parent (voir Parent.username).
  username           String   @unique
  passwordHash       String
  name               String
  bio                String?
  ratePerSession     Float?
  verified           Boolean  @default(false)
  // Vrai pour un compte créé par l'espace développeur suite à une candidature : le prof doit
  // définir son propre mot de passe avant d'accéder à son espace.
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  availabilities      TeacherAvailability[]
  tutoringRequests    TutoringRequest[]
  chatThreads         ChatThreadParticipant[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  teacherExercises    TeacherExercise[]
  students            Child[]                 @relation("TeacherStudents")
}

enum TeacherApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// Un prof ne peut plus s'inscrire directement : il envoie une candidature (message), qui est
// validée depuis l'espace développeur — c'est cette validation qui crée le compte Teacher et
// génère un mot de passe temporaire à relayer au prof.
model TeacherApplication {
  id         String                   @id @default(cuid())
  name       String
  email      String                   @unique
  message    String?
  status     TeacherApplicationStatus @default(PENDING)
  createdAt  DateTime                 @default(now())
  reviewedAt DateTime?
}

model TeacherAvailability {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  weekday   Int // 0-6
  startTime String // "HH:mm"
  endTime   String // "HH:mm"

  @@index([teacherId])
}

model DevAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

// Jeton de réinitialisation de mot de passe (parent OU prof — un seul des deux renseigné),
// à usage unique (usedAt), courte durée de vie. Le token lui-même n'est jamais stocké en clair,
// seul son hash (même fonction que les mots de passe) — comme ça, un accès en lecture à la base
// ne suffit pas à réinitialiser un compte à la place de son propriétaire.
model PasswordResetToken {
  id        String    @id @default(cuid())
  parentId  String?
  parent    Parent?   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Teacher?  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([parentId])
  @@index([teacherId])
}

// ---------------------------------------------------------------------------
// Contenu pédagogique (cœur Kumon)
// ---------------------------------------------------------------------------

model Subject {
  id     String  @id @default(cuid())
  code   String  @unique // "MATH"
  name   String
  skills Skill[]
}

model Skill {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  code      String  @unique // "addition", "fractions"...
  name      String
  order     Int
  minAge    Int

  levels          Level[]
  progress        ChildSkillProgress[]
  recommendations DailyRecommendation[]

  @@index([subjectId])
}

model Level {
  id                      String @id @default(cuid())
  skillId                 String
  skill                   Skill  @relation(fields: [skillId], references: [id])
  order                   Int
  name                    String
  unlockThreshold         Float  @default(0.9)
  minExerciseCount        Int    @default(15)
  evaluationExerciseCount Int    @default(10)
  retryCooldownHours      Int    @default(24)

  exercises        Exercise[]
  evaluations      Evaluation[]
  tutoringRequests TutoringRequest[]
  teacherExercises TeacherExercise[]
  curatedExercises CuratedExercise[]
  lessons          Lesson[]
  completionBonuses LevelCompletionBonus[]

  @@unique([skillId, order])
}

enum ExerciseType {
  MCQ
  NUMERIC
  FREE_TEXT
}

model Exercise {
  id           String       @id @default(cuid())
  levelId      String
  level        Level        @relation(fields: [levelId], references: [id])
  type         ExerciseType
  generatorKey String
  paramsSchema Json
  staticPrompt String?
  staticAnswer Json?
  difficulty   Int          @default(1)
  createdAt    DateTime     @default(now())

  instances ExerciseInstance[]

  @@index([levelId])
}

model ExerciseInstance {
  id            String   @id @default(cuid())
  exerciseId    String
  exercise      Exercise @relation(fields: [exerciseId], references: [id])
  seed          String
  promptText    String
  correctAnswer Json
  createdAt     DateTime @default(now())

  attempts           ExerciseAttempt[]
  evaluationAttempts EvaluationAttempt[]

  @@index([exerciseId])
}

model ChildSkillProgress {
  id             String   @id @default(cuid())
  childId        String
  child          Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  skillId        String
  skill          Skill    @relation(fields: [skillId], references: [id])
  currentLevelId String?
  masteryScore   Float    @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([childId, skillId])
}

// PRACTICE uniquement — jamais touché par la logique anti-triche
model ExerciseAttempt {
  id                 String           @id @default(cuid())
  childId            String
  child              Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  exerciseInstanceId String
  exerciseInstance   ExerciseInstance @relation(fields: [exerciseInstanceId], references: [id])
  answerGiven        Json
  isCorrect          Boolean
  timeTakenMs        Int
  createdAt          DateTime         @default(now())

  @@index([childId])
  @@index([exerciseInstanceId])
}

// Exercice écrit par un vrai prof (par opposition aux Exercise générés proceduralement
// ci-dessus) — jamais noté automatiquement, toujours corrigé à la main par le prof qui l'a
// déposé (voir TeacherExerciseSubmission). Réservé aux enfants ayant assez de points ET ayant
// déjà atteint le niveau ciblé (voir src/lib/progression/teacherExercises.ts).
enum TeacherExerciseStatus {
  DRAFT
  PUBLISHED
}

model TeacherExercise {
  id              String                @id @default(cuid())
  teacherId       String
  teacher         Teacher               @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  levelId         String
  level           Level                 @relation(fields: [levelId], references: [id], onDelete: Cascade)
  title           String
  promptText      String
  // Corrigé de référence à l'usage du prof seul (aide à la correction) — jamais utilisé pour
  // une comparaison automatique, contrairement à ExerciseInstance.correctAnswer.
  referenceAnswer String?
  pointsRequired  Int                   @default(0)
  status          TeacherExerciseStatus @default(DRAFT)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  // Document réel (photo/scan de fiche, PDF) joint par le prof, affiché à l'enfant à côté des
  // cases de réponse — à la place d'un simple énoncé retapé en texte. Stocké directement en base
  // (pas de service de stockage externe à provisionner) : taille limitée côté action serveur.
  documentData     Bytes?
  documentMimeType String?
  documentFileName String?

  // Classe scolaire ciblée (ex. "6e"), optionnelle et distincte du Level du programme — sert à
  // regrouper le contenu par classe dans l'espace cours (voir GRADE_LEVELS). null = "Non classé".
  gradeLevel String?

  submissions TeacherExerciseSubmission[]

  @@index([teacherId])
  @@index([levelId])
}

enum TeacherExerciseSubmissionStatus {
  PENDING
  GRADED
}

model TeacherExerciseSubmission {
  id                String                          @id @default(cuid())
  teacherExerciseId String
  teacherExercise   TeacherExercise                 @relation(fields: [teacherExerciseId], references: [id], onDelete: Cascade)
  childId           String
  child             Child                           @relation(fields: [childId], references: [id], onDelete: Cascade)
  answerText        String
  status            TeacherExerciseSubmissionStatus @default(PENDING)
  isCorrect         Boolean?
  feedback          String?
  gradedAt          DateTime?
  createdAt         DateTime                        @default(now())

  @@index([teacherExerciseId])
  @@index([childId])
}

// ---------------------------------------------------------------------------
// Contenu collège/lycée sourcé (curation périodique + exercices inspirés)
// ---------------------------------------------------------------------------

enum CuratedExerciseSourceType {
  // Reproduit fidèlement une ressource explicitement sous licence libre (jamais un contenu
  // sous droits d'auteur reproduit tel quel).
  OFFICIAL_OPEN_SOURCE
  // Énoncé réécrit, inspiré d'une source réelle mais jamais copié verbatim — la source et sa
  // licence sont documentées pour traçabilité.
  INSPIRED_BY_SOURCE
}

enum CuratedExerciseStatus {
  PENDING
  APPROVED
  REJECTED
}

// Exercice proposé périodiquement par une Routine Claude (voir src/lib/devscan/curatedExercises.ts
// et /api/dev/curated-exercises) pour combler le programme collège/lycée, au-delà du primaire déjà
// couvert par le moteur de générateurs procéduraux. Jamais publié automatiquement — passe par la
// même validation humaine que DevSuggestion. La correction reste toujours déterministe
// (correctAnswer vérifiable via answersMatch, jamais une IA qui "devine" si la réponse est juste).
model CuratedExercise {
  id              String                    @id @default(cuid())
  levelId         String
  level           Level                     @relation(fields: [levelId], references: [id], onDelete: Cascade)
  promptText      String
  correctAnswer   String
  sourceType      CuratedExerciseSourceType
  sourceUrl       String
  sourceLicense   String
  // Classe scolaire ciblée (ex. "5e"), optionnelle — regroupement par classe dans l'espace cours.
  gradeLevel      String?
  status          CuratedExerciseStatus     @default(PENDING)
  createdAt       DateTime                  @default(now())
  reviewedAt      DateTime?

  attempts CuratedExerciseAttempt[]

  @@index([levelId])
  @@index([status])
}

model CuratedExerciseAttempt {
  id                String          @id @default(cuid())
  curatedExerciseId String
  curatedExercise   CuratedExercise @relation(fields: [curatedExerciseId], references: [id], onDelete: Cascade)
  childId           String
  child             Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  answerGiven       String
  isCorrect         Boolean
  createdAt         DateTime        @default(now())

  @@index([curatedExerciseId])
  @@index([childId])
}

enum LessonType {
  VIDEO
  DOCUMENT
  AI_PAGE
}

// Leçon façon CNED : explique un concept, distincte des exercices infinis générés — l'enfant peut
// y revenir librement, sans gating par points (contrairement à TeacherExercise). Rattachée à un
// Level, comme Exercise/Evaluation/TeacherExercise.
model Lesson {
  id               String     @id @default(cuid())
  levelId          String
  level            Level      @relation(fields: [levelId], references: [id], onDelete: Cascade)
  title            String
  type             LessonType
  // VIDEO : lien YouTube. DOCUMENT : fichier joint (mêmes champs que TeacherExercise.documentData).
  // AI_PAGE : contenu rédigé au moment de l'ajout (jamais généré en direct par un appel IA payant),
  // toujours basé sur l'une des deux autres sources (voir contentSourceUrl).
  videoUrl         String?
  documentData     Bytes?
  documentMimeType String?
  documentFileName String?
  contentMarkdown  String?
  contentSourceUrl String?
  // Classe scolaire ciblée (ex. "CM1"), optionnelle — regroupement par classe dans l'espace cours.
  gradeLevel       String?
  createdAt        DateTime   @default(now())

  @@index([levelId])
}

// ---------------------------------------------------------------------------
// Évaluation & anti-triche
// ---------------------------------------------------------------------------

enum EvaluationStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  INVALIDATED
}

model Evaluation {
  id              String           @id @default(cuid())
  childId         String
  child           Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  levelId         String
  level           Level            @relation(fields: [levelId], references: [id])
  status          EvaluationStatus @default(NOT_STARTED)
  sessionToken    String?
  lastHeartbeatAt DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  totalScore      Float?
  passed          Boolean?
  invalidReason   String?
  createdAt       DateTime         @default(now())

  attempts        EvaluationAttempt[]
  integrityEvents IntegrityEvent[]

  @@index([childId])
  @@index([levelId])
}

model EvaluationAttempt {
  id                 String           @id @default(cuid())
  evaluationId       String
  evaluation         Evaluation       @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  exerciseInstanceId String
  exerciseInstance   ExerciseInstance @relation(fields: [exerciseInstanceId], references: [id])
  order              Int
  answerGiven        Json?
  isCorrect          Boolean?
  scoreOverride      Float? // forcé à 0 par le serveur si triche détectée
  suspicionScore     Float? // FREE_TEXT uniquement, sortie du détecteur IA
  timeTakenMs        Int?
  presentedAt        DateTime         @default(now())
  answeredAt         DateTime?

  @@unique([evaluationId, order])
}

enum IntegrityEventType {
  FULLSCREEN_EXIT
  VISIBILITY_HIDDEN
  WINDOW_BLUR
  DEVTOOLS_SUSPECTED
  COPY_ATTEMPT
  PASTE_ATTEMPT
  AI_TEXT_SUSPECTED
  SESSION_TOKEN_INVALID
  HEARTBEAT_MISSED
  MULTI_TAB_DETECTED
}

enum IntegritySeverity {
  LOW
  MEDIUM
  HIGH
}

enum IntegrityAction {
  LOGGED_ONLY
  WARNED
  ZEROED_QUESTION
  ZEROED_EVALUATION
}

model IntegrityEvent {
  id                  String             @id @default(cuid())
  evaluationId        String
  evaluation          Evaluation         @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  evaluationAttemptId String?
  childId             String
  child               Child              @relation(fields: [childId], references: [id], onDelete: Cascade)
  type                IntegrityEventType
  severity            IntegritySeverity
  actionTaken         IntegrityAction
  metadata            Json?
  clientTimestamp     DateTime?
  serverTimestamp     DateTime           @default(now())
  viewedByParentAt    DateTime?

  @@index([evaluationId])
  @@index([childId])
}

// Baseline personnelle d'écriture de l'enfant (calculée sur les réponses practice, non surveillées)
model ChildWritingProfile {
  id                String   @id @default(cuid())
  childId           String   @unique
  child             Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  avgWordLength     Float?
  avgSentenceLength Float?
  commonErrorRate   Float?
  vocabComplexity   Float?
  sampleCount       Int      @default(0)
  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Points, récompenses, encouragement
// ---------------------------------------------------------------------------

model PointsWallet {
  id             String   @id @default(cuid())
  childId        String   @unique
  child          Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  balance        Int      @default(0)
  lifetimeEarned Int      @default(0)
  updatedAt      DateTime @updatedAt

  transactions PointsTransaction[]
}

enum PointsTransactionType {
  EARNED_EXERCISE
  EARNED_EVALUATION
  EARNED_STREAK
  EARNED_BADGE
  SPENT_REWARD
  ADJUSTMENT
}

model PointsTransaction {
  id        String                @id @default(cuid())
  walletId  String
  wallet    PointsWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type      PointsTransactionType
  amount    Int // positif = gain, négatif = dépense
  reason    String
  createdAt DateTime              @default(now())

  @@index([walletId])
}

// COSMETIC : sans effet mécanique (juste échangée contre des points, ex. thème de couleurs).
// STREAK_FREEZE : "jour de repos" — voir RewardRedemption.consumedAt et
// src/lib/progression/streaks.ts (recordDailyActivity) pour l'effet réel sur la série.
enum RewardCatalogItemKind {
  COSMETIC
  STREAK_FREEZE
}

model RewardCatalogItem {
  id          String                @id @default(cuid())
  code        String                @unique
  label       String
  description String
  cost        Int
  icon        String?
  kind        RewardCatalogItemKind @default(COSMETIC)
  active      Boolean               @default(true)
  createdAt   DateTime              @default(now())

  redemptions RewardRedemption[]
}

model RewardRedemption {
  id         String            @id @default(cuid())
  childId    String
  child      Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  itemId     String
  item       RewardCatalogItem @relation(fields: [itemId], references: [id])
  redeemedAt DateTime          @default(now())
  // Non-null une fois qu'un jour de repos (STREAK_FREEZE) a réellement protégé un jour manqué —
  // seules les redemptions non consommées (consumedAt: null) sont disponibles à utiliser.
  // Sans effet pour les récompenses COSMETIC.
  consumedAt DateTime?

  @@index([childId])
}

model Badge {
  id          String       @id @default(cuid())
  code        String       @unique
  label       String
  description String
  icon        String
  children    ChildBadge[]
}

model ChildBadge {
  id       String   @id @default(cuid())
  childId  String
  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id])
  earnedAt DateTime @default(now())

  @@unique([childId, badgeId])
}

model Streak {
  id               String    @id @default(cuid())
  childId          String    @unique
  child            Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?
}

// "Cours du jour" façon Duolingo : une compétence recommandée par enfant et par jour civil,
// calculée à la demande (voir src/lib/progression/recommendation.ts) — le index unique sur
// [childId, date] fait qu'un nouveau jour calendaire déclenche naturellement un nouveau calcul,
// sans tâche planifiée séparée à maintenir.
model DailyRecommendation {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id])
  date      DateTime
  reason    String
  createdAt DateTime @default(now())

  @@unique([childId, date])
}

// Bonus "catégorie complétée" (+29 points) attribué UNE SEULE FOIS par niveau, quand l'enfant
// atteint pour la première fois le seuil de maîtrise du niveau (prêt pour l'évaluation). L'unicité
// [childId, levelId] garantit qu'on ne le donne jamais deux fois.
model LevelCompletionBonus {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  levelId   String
  level     Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([childId, levelId])
  @@index([childId])
}

// Boîte surprise quotidienne : achetable une seule fois par jour civil (unicité [childId, date]),
// uniquement après avoir fait le cours du jour + un peu de pratique. Ne fait gagner que des points
// internes — jamais de récompense à valeur monétaire réelle.
model DailyMysteryBox {
  id           String   @id @default(cuid())
  childId      String
  child        Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  date         DateTime
  rewardPoints Int
  isJackpot    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([childId, date])
  @@index([childId])
}

// ---------------------------------------------------------------------------
// Évaluation honnête et rapports narratifs
// ---------------------------------------------------------------------------

model ChildAssessment {
  id             String   @id @default(cuid())
  childId        String
  child          Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  periodEnd      DateTime
  objectiveScore Float // moyenne des scores d'évaluation sur la période
  effortScore    Float // tentatives, régularité, progression vs baseline propre
  narrative      String // texte honnête, personnalisé, sans favoritisme
  generatedBy    String   @default("ai-scan") // "ai-scan" | "manual"
  createdAt      DateTime @default(now())

  @@index([childId])
}

model ProgressReport {
  id          String   @id @default(cuid())
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  summary     Json
  generatedAt DateTime @default(now())
}

model LessonStoryEntry {
  id                  String   @id @default(cuid())
  childId             String
  child               Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  relatedEvaluationId String?
  title               String
  narrative           String // récit de ce qui s'est passé, pas un tableau de chiffres
  highlights          Json? // points positifs/à travailler, structuré mais présenté narrativement
  createdAt           DateTime @default(now())

  @@index([childId])
}

// ---------------------------------------------------------------------------
// Marketplace de cours particuliers + paiement simulé
// ---------------------------------------------------------------------------

enum TutoringRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  ACTIVE
  ENDED
}

model TutoringRequest {
  id            String                @id @default(cuid())
  parentId      String
  parent        Parent                @relation(fields: [parentId], references: [id], onDelete: Cascade)
  childId       String
  child         Child                 @relation(fields: [childId], references: [id], onDelete: Cascade)
  teacherId     String
  teacher       Teacher               @relation(fields: [teacherId], references: [id])
  targetLevelId String
  targetLevel   Level                 @relation(fields: [targetLevelId], references: [id])
  targetScore   Float // objectif de note (0-1) sur le niveau ciblé
  proposedRate  Float
  status        TutoringRequestStatus @default(PENDING)
  periodStart   DateTime?
  periodEnd     DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  payoutDecisions TutoringPayoutDecision[]

  @@index([parentId])
  @@index([childId])
  @@index([teacherId])
}

enum PayoutDecisionStatus {
  ELIGIBLE
  NOT_ELIGIBLE
}

// Décision archivée et IMMUABLE : jamais de UPDATE, une correction crée une nouvelle ligne
// référençant `supersedesId`. Objectif : empêcher toute contestation de sabotage ou de
// favoritisme après-coup — la décision se base sur la trajectoire complète, pas un seul test.
model TutoringPayoutDecision {
  id                 String               @id @default(cuid())
  tutoringRequestId  String
  tutoringRequest    TutoringRequest      @relation(fields: [tutoringRequestId], references: [id], onDelete: Cascade)
  periodStart        DateTime
  periodEnd          DateTime
  status             PayoutDecisionStatus
  achievedScore      Float
  effortScore        Float
  amountSimulated    Float
  explanation        String
  assessmentSnapshot Json // snapshot des ChildAssessment/EvaluationAttempt pertinents
  supersedesId       String?
  decidedAt          DateTime             @default(now())

  @@index([tutoringRequestId])
}

// ---------------------------------------------------------------------------
// Messagerie
// ---------------------------------------------------------------------------

enum ChatThreadType {
  CHILD_PARENT_TEACHER
  PARENT_TEACHER_PRIVATE
}

model ChatThread {
  id        String         @id @default(cuid())
  type      ChatThreadType
  childId   String? // null pour un fil PARENT_TEACHER_PRIVATE
  createdAt DateTime       @default(now())

  participants ChatThreadParticipant[]
  messages     ChatMessage[]
}

enum ParticipantRole {
  PARENT
  CHILD
  TEACHER
}

model ChatThreadParticipant {
  id        String          @id @default(cuid())
  threadId  String
  thread    ChatThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      ParticipantRole
  parentId  String?
  parent    Parent?         @relation(fields: [parentId], references: [id], onDelete: Cascade)
  childId   String?
  child     Child?          @relation(fields: [childId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Teacher?        @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

model ChatMessage {
  id         String          @id @default(cuid())
  threadId   String
  thread     ChatThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderRole ParticipantRole
  senderId   String
  body       String
  createdAt  DateTime        @default(now())

  @@index([threadId])
}

model Notification {
  id        String    @id @default(cuid())
  parentId  String?
  parent    Parent?   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   Teacher?  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  type      String // "CHAT_MESSAGE" | "TUTORING_UPDATE" | ...
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([parentId])
  @@index([teacherId])
}

// Boîte à suggestions parent/enfant, distincte de la messagerie enfant/prof/parent
model SuggestionThread {
  id        String   @id @default(cuid())
  parentId  String?
  parent    Parent?  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  childId   String?
  child     Child?   @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  messages SuggestionMessage[]
}

model SuggestionMessage {
  id         String           @id @default(cuid())
  threadId   String
  thread     SuggestionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorRole ParticipantRole // PARENT | CHILD
  body       String
  createdAt  DateTime         @default(now())
  scannedAt  DateTime? // renseigné quand le scan IA l'a synthétisée dans un digest

  @@index([threadId])
}

// ---------------------------------------------------------------------------
// Espace développeur & scan IA automatisé
// ---------------------------------------------------------------------------

enum DevSuggestionCategory {
  CONTENT
  DIFFICULTY
  FEATURE
  CODE
}

enum DevSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
}

model DevSuggestion {
  id          String                @id @default(cuid())
  category    DevSuggestionCategory
  title       String
  description String
  sourceData  Json? // ce qui a motivé la suggestion (stats, messages de suggestion, etc.)
  status      DevSuggestionStatus   @default(PENDING)
  prUrl       String?
  createdAt   DateTime              @default(now())
  reviewedAt  DateTime?

  @@index([status])
}

// Trace de chaque passage du scan IA (3x/jour), pour audit et pour éviter les doublons
model AiScanRun {
  id                 String   @id @default(cuid())
  runAt              DateTime @default(now())
  childrenScanned    Int
  suggestionsCreated Int
  digestSentEmail    Boolean  @default(false)
  digestSentSms      Boolean  @default(false)
  summary            Json
}
