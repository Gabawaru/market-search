# Base de données Postgres (voir docker-compose.yml pour le dev local)
DATABASE_URL="postgresql://oumno:oumno_dev_password@localhost:5432/oumno_education?schema=public"

# NextAuth (Auth.js) — compte parent/prof
AUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"
# Doit correspondre exactement au port sur lequel l'app tourne (sinon les redirections
# après connexion pointent vers le mauvais port et échouent silencieusement).
NEXTAUTH_URL="http://localhost:3000"

# Session PIN enfant (JWT signé séparément de NextAuth)
CHILD_SESSION_SECRET="changeme-generate-with-openssl-rand-base64-32"

# Détecteur de réponse type IA (module pluggable)
AI_TEXT_DETECTOR_PROVIDER="heuristic"

# Notifications admin (scan IA / boîte à suggestions) — NE JAMAIS mettre en dur dans le code
ADMIN_NOTIFY_EMAIL=""
ADMIN_NOTIFY_PHONE=""

# Fournisseur email (optionnel, pour activer les digests par email)
EMAIL_PROVIDER="none" # "none" | "resend" | "smtp"
RESEND_API_KEY=""
SMTP_URL=""

# Fournisseur SMS (optionnel, pour activer les digests par SMS)
SMS_PROVIDER="none" # "none" | "twilio"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
